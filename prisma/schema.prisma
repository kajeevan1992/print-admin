generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  PENDING_ACTIVATION
}

enum DomainType {
  PLATFORM_SUBDOMAIN
  CUSTOM_DOMAIN
}

enum DomainVerificationStatus {
  VERIFIED
  PENDING
  NOT_ADDED
}

enum SSLStatus {
  ISSUED
  PENDING
  NOT_STARTED
}

enum UserRole {
  SUPERADMIN
  TENANT_OWNER
  TENANT_ADMIN
  TENANT_STAFF
  CUSTOMER
}

enum ProductType {
  STANDARD
  QUOTE_LED
  TEMPLATE_LED
  UPLOAD_LED
}

enum OrderStatus {
  DRAFT
  AWAITING_PAYMENT
  ARTWORK_CHECK
  AWAITING_APPROVAL
  APPROVED
  IN_PRODUCTION
  QUALITY_CHECK
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum ArtworkStatus {
  UPLOADED
  CHECKING
  APPROVED
  CHANGES_REQUESTED
}

model Tenant {
  id               String       @id @default(cuid())
  name             String
  slug             String       @unique
  status           TenantStatus @default(PENDING_ACTIVATION)
  defaultSubdomain String       @unique
  primaryDomain    String?
  planName         String       @default("Starter")
  storefrontsLimit Int          @default(1)
  adminUsersLimit  Int          @default(3)
  storageLimitGb   Int          @default(10)
  themeKey         String       @default("base")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  users            User[]
  domains          Domain[]
  auditLogs        AuditLog[]
}

model User {
  id             String         @id @default(cuid())
  tenantId       String?
  email          String         @unique
  name           String?
  role           UserRole       @default(CUSTOMER)
  passwordHash   String?
  isActive       Boolean        @default(true)
  lastLoginAt    DateTime?
  sessionVersion Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  tenant         Tenant?        @relation(fields: [tenantId], references: [id])
  adminSessions  AdminSession[]
}

model AdminSession {
  id             String   @id @default(cuid())
  userId         String
  tenantId       String?
  tokenHash      String   @unique
  roleSnapshot   String
  sessionVersion Int      @default(1)
  ipAddress      String?
  userAgent      String?
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tenantId])
  @@index([expiresAt])
}

model Domain {
  id                 String                   @id @default(cuid())
  tenantId           String
  domain             String                   @unique
  type               DomainType
  verificationStatus DomainVerificationStatus @default(PENDING)
  sslStatus          SSLStatus                @default(NOT_STARTED)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  tenant             Tenant                   @relation(fields: [tenantId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  action    String
  actor     String?
  metadata  Json?
  createdAt DateTime @default(now())
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
}

model CoreCatalogRecord {
  id           String   @id
  tenantId     String
  resource     String
  slug         String
  name         String
  description  String   @default("")
  metadataJson Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, resource, slug])
  @@index([tenantId, resource])
  @@index([resource, slug])
}
