# PostgreSQL — production must use a managed/backup-enabled database.
DATABASE_URL="postgresql://user:password@database-host:5432/printcore?schema=public"
# Prefer a direct/non-pooled connection for Prisma migrations when the provider supplies one.
DATABASE_DIRECT_URL="postgresql://user:password@database-host:5432/printcore?schema=public"

# One-time deployment bootstrap. Existing accounts with passwords are never overwritten.
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="<strong-temporary-or-managed-secret>"
BOOTSTRAP_ADMIN_NAME="Admin User"
BOOTSTRAP_TENANT_NAME="HOLO Print"
DEFAULT_TENANT_ID="holo-print-sidcup"
# Runtime requests must never create or alter authentication schema.
ALLOW_RUNTIME_AUTH_BOOTSTRAP="false"

# Final application and storefront URLs. Use HTTPS and the real HOLO domains.
NEXT_PUBLIC_APP_URL="https://admin.example.com"
APP_URL="https://admin.example.com"
NEXT_PUBLIC_SITE_URL="https://www.example.com"
SITE_URL="https://www.example.com"
NEXT_PUBLIC_STOREFRONT_URL="https://www.example.com"
STOREFRONT_URL="https://www.example.com"
CORS_ORIGINS="https://www.example.com"
ALLOWED_ORIGINS="https://www.example.com"

# Optional external API connection. Never use the old HTTP sslip.io address in production.
EXTERNAL_API_BASE_URL="https://api.example.com"

# Stripe checkout and verified webhook processing.
STRIPE_SECRET_KEY="<stripe-live-secret-key>"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="<stripe-live-publishable-key>"
STRIPE_WEBHOOK_SECRET="<stripe-webhook-signing-secret>"

# Dedicated HMAC secret used in signed storefront payment return/retry links.
STOREFRONT_PAYMENT_TOKEN_SECRET="<at-least-32-random-bytes>"

# Stable AES-256-GCM material for storefront customer authenticator secrets.
CUSTOMER_MFA_ENCRYPTION_KEY="<at-least-32-random-bytes>"

# Tenant/platform SMTP and email outbox delivery.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="<smtp-user>"
SMTP_PASS="<smtp-password>"
SMTP_FROM="HOLO Print <hello@example.com>"

# Development seed safety. Keep disabled in production.
ALLOW_PRODUCTION_DEV_SEED="false"
# Only required for an exceptional, explicitly authorised production seed operation.
DEV_SEED_SECRET="<at-least-32-random-bytes>"

# Development only. Production always rejects unsigned Stripe webhooks.
ALLOW_UNSIGNED_STRIPE_WEBHOOKS="false"
