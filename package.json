{
  "name": "print-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "prisma generate || echo \"Prisma generate skipped or failed at runtime; continuing app start\"; prisma migrate deploy || echo \"Prisma migrate deploy skipped or failed; app will start with safe runtime fallbacks\"; NEXT_TELEMETRY_DISABLED=1 next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "postinstall": "echo \"Skipping prisma generate during install\"",
    "seed:dev": "echo 'Use POST /api/dev/seed after deploy'"
  },
  "dependencies": {
    "lucide-react": "^0.525.0",
    "next": "^14.2.30",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4",
    "@prisma/client": "^5.22.0",
    "framer-motion": "^11.11.17",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.57",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.30",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "prisma": "^5.22.0",
    "@types/pg": "^8.11.10"
  },
  "engines": {
    "node": ">=20.19.0 <21 || >=22.13.0 <23"
  },
  "packageManager": "pnpm@9.15.9"
}