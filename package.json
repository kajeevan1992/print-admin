{
  "name": "print-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "node scripts/prisma-generate-with-db-env.cjs && node scripts/prisma-migrate-with-db-env.cjs && node scripts/bootstrap-admin-with-db-env.cjs && NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "node scripts/prisma-generate-with-db-env.cjs && node scripts/prisma-migrate-with-db-env.cjs && node scripts/bootstrap-admin-with-db-env.cjs && NEXT_TELEMETRY_DISABLED=1 next start",
    "lint": "next lint",
    "theme:check": "node scripts/validate-v0-themes.mjs",
    "theme:create": "node scripts/create-v0-theme.mjs",
    "theme:install": "node scripts/install-v0-theme.mjs",
    "theme:registry": "node scripts/sync-v0-theme-registry.mjs",
    "theme:registry:check": "node scripts/sync-v0-theme-registry.mjs --check",
    "launch:hardening:check": "node scripts/validate-launch-hardening.mjs",
    "prisma:generate": "node scripts/prisma-generate-with-db-env.cjs",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "node scripts/prisma-migrate-with-db-env.cjs",
    "prisma:push": "prisma db push",
    "db:generate": "node scripts/prisma-generate-with-db-env.cjs",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "node scripts/prisma-migrate-with-db-env.cjs",
    "postinstall": "echo \"Skipping prisma generate during install\"",
    "seed:dev": "echo 'Use authenticated POST /api/dev/seed outside production'"
  },
  "dependencies": {
    "@measured/puck": "latest",
    "@prisma/client": "^5.22.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "framer-motion": "^11.11.17",
    "jszip": "^3.10.1",
    "lucide-react": "^0.525.0",
    "next": "^14.2.30",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.57",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.30",
    "postcss": "^8.5.6",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "packageManager": "pnpm@9.15.9"
}
